# Copy to .env and fill in. Never commit the real .env.

# Server
PORT=7500
# Frontend origin allowed by CORS (defaults to http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000
# Set when running behind a reverse proxy / load balancer so rate limits see
# real client IPs: the number of proxy hops to trust (usually 1). Leave unset
# when clients connect directly.
TRUST_PROXY=

# MySQL (create tables with database/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=book_project

# Secret used to sign login tokens: any long random string
JWT_SECRET_KEY=

# API keys
GOOGLE_BOOKS_API_KEY=
OPEN_AI_KEY=
